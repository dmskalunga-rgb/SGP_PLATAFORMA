# Mount institutional certificate/key externally; never bake private keys into images.
server {
  listen 8443 ssl;
  server_name _;
  ssl_certificate /run/secrets/sgp_tls_cert;
  ssl_certificate_key /run/secrets/sgp_tls_key;
  ssl_protocols TLSv1.2 TLSv1.3;
  root /usr/share/nginx/html;
  server_tokens off;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
  }
  location /health/ { proxy_pass ${API_UPSTREAM}; }
  location / { try_files $uri $uri/ /index.html; }
}
