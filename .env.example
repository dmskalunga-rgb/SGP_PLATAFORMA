# Empty values are intentional. Supply separate protected settings for each environment.
DATABASE_URL=
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Same-origin web proxy upstream for local Vite / runtime Nginx:
API_UPSTREAM=http://127.0.0.1:3000
# Optional build-time browser base; empty selects the same-origin proxy:
VITE_API_BASE_URL=
