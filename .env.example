# Empty values are intentional. Supply separate protected settings for each environment.
DATABASE_URL=
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Same-origin web proxy upstream for local Vite / runtime Nginx:
API_UPSTREAM=http://127.0.0.1:3000
# Optional build-time browser base; empty selects the same-origin proxy:
VITE_API_BASE_URL=
# M1B: distinct app_runtime / auth_runtime connections, secrets supplied externally.
# In staging/production PostgreSQL URLs must use sslmode=verify-full and a trusted CA.
AUTH_DATABASE_URL=
AUTH_ORIGIN=
# Explicit trusted gateway IPs only, comma-separated; never wildcard trust.
AUTH_TRUSTED_PROXY_IPS=
# Optional direct API TLS; otherwise use the verified institutional TLS gateway.
TLS_CERT_FILE=
TLS_KEY_FILE=
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
AUTH_HASH_CONCURRENCY=2
PASSWORD_MIN_LENGTH=15
PASSWORD_MAX_LENGTH=128
