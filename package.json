{
  "name": "sgp-dispo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "migrate": "node scripts/migrate.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:frontend": "playwright test",
    "test:policy": "node scripts/check-policy.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --omit=dev"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "@playwright/test": "1.65.0"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
